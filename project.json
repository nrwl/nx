{
  "name": "@nx/nx-source",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "targets": {
    "local-registry": {
      "executor": "@nx/js:verdaccio",
      "inputs": [
        "{workspaceRoot}/.verdaccio/**/*",
        { "externalDependencies": ["verdaccio"] }
      ],
      "options": {
        "port": 4873,
        "config": ".verdaccio/config.yml",
        "storage": "dist/local-registry/storage",
        "clear": false
      }
    },
    "local-registry-e2e": {
      "executor": "@nx/js:verdaccio",
      "readyWhen": { "signal": true },
      "inputs": [
        "{workspaceRoot}/.verdaccio/**/*",
        { "externalDependencies": ["verdaccio"] }
      ],
      "options": {
        "port": 4873,
        "config": ".verdaccio/config.yml",
        "storage": "dist/local-registry/storage",
        "clear": false,
        "location": "none"
      }
    },
    "populate-local-registry-storage": {
      "cache": true,
      "ultracache": { "mode": "warn" },
      "inputs": [
        {
          "input": "production",
          "projects": ["tag:npm:public"]
        },
        {
          "input": "production",
          "projects": ["tag:maven:dev.nx.maven"]
        },
        {
          "input": "production",
          "projects": ["MsbuildAnalyzer", ":gradle-batch-runner"]
        },
        "{workspaceRoot}/scripts/local-registry",
        "native"
      ],
      "dependsOn": [
        { "target": "local-registry-e2e", "waitFor": "ready" },
        {
          "target": "build",
          "projects": ["tag:npm:public"]
        }
      ],
      "command": "node ./scripts/local-registry/run-populate-storage.mjs",
      "outputs": ["{workspaceRoot}/dist/local-registry/storage"]
    },
    "populate-e2e-base-workspace": {
      "cache": true,
      "ultracache": { "mode": "warn" },
      "inputs": [
        "{workspaceRoot}/scripts/local-registry/**/*",
        {
          "runtime": "node ./scripts/local-registry/package-manager-versions.mjs"
        },
        { "dependentTasksOutputFiles": "**/*" }
      ],
      "dependsOn": [
        { "target": "local-registry-e2e", "waitFor": "ready" },
        "populate-local-registry-storage"
      ],
      "command": "node ./scripts/local-registry/build-e2e-base-workspace.mjs",
      "outputs": ["{workspaceRoot}/dist/local-registry/proj-backup/*.tar"]
    },
    "nx-release": {
      "dependsOn": [
        {
          "target": "build",
          "projects": ["tag:npm:public"]
        }
      ],
      "command": "tsx ./scripts/nx-release.ts"
    },
    "start-docker-registry": {
      "continuous": true,
      "command": "docker run --rm -p 5000:5000 --name local-docker-registry registry:2"
    },
    "playwright-install": {
      "cache": false,
      "command": "playwright install --only-shell chromium"
    },
    "playwright-install-e2e": {
      "cache": false,
      "command": "node ./scripts/e2e-browser-install.mjs playwright"
    },
    "cypress-install-e2e": {
      "cache": false,
      "command": "node ./scripts/e2e-browser-install.mjs cypress"
    },
    "check-format:quick": {
      "parallelism": false
    },
    "lint": {
      "command": "eslint pnpm-lock.yaml",
      "dependsOn": [],
      "cache": true,
      "inputs": [
        "{projectRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tsconfig.json",
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ]
    },
    "prepush": {
      "dependsOn": [
        "nx:format-native",
        "nx:lint-native",
        "check-commit",
        "check-format:quick",
        "check-oxlint:quick",
        "check-lock-files",
        "astro-docs:format"
      ]
    }
  }
}
