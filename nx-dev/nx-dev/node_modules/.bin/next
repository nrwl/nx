else
  export NODE_PATH="/Users/jack/projects/nx/node_modules/.pnpm/next@15.5.25_@babel+core@7.29.7_supports-color@10.2.2__@opentelemetry+api@1.9.1_@playwr_b341924ce798f45d86782583e65619a8/node_modules/next/node_modules:/Users/jack/projects/nx/node_modules/.pnpm/next@15.5.25_@babel+core@7.29.7_supports-color@10.2.2__@opentelemetry+api@1.9.1_@playwr_b341924ce798f45d86782583e65619a8/node_modules:/Users/jack/projects/nx/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -n "$exe" ] && [ -x "$basedir/node.exe" ]; then
  exec "$basedir/node.exe"  "$basedir_win/../next/dist/bin/next" "$@"
elif [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../next/dist/bin/next" "$@"
elif command -v node >/dev/null 2>&1; then
  exec node  "$basedir/../next/dist/bin/next" "$@"
elif [ -n "$exe" ] && command -v node.exe >/dev/null 2>&1; then
  exec node.exe  "$basedir_win/../next/dist/bin/next" "$@"
else
  exec node  "$basedir/../next/dist/bin/next" "$@"
fi
