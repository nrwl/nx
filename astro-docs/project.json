{
  "name": "astro-docs",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "comment": "package.json#scripts runs in the project root directory with astro assumes is where the node_modules is. which fails. so run the scripts in project.json#targets with --root command instead",
  "targets": {
    "prebuild-banner": {
      "cache": false,
      "inputs": [
        "{workspaceRoot}/scripts/documentation/prebuild-banner.mjs",
        { "env": "BANNER_URL" }
      ],
      "outputs": ["{projectRoot}/src/content/banner.json"],
      "command": "node ../scripts/documentation/prebuild-banner.mjs",
      "options": {
        "cwd": "astro-docs",
        "env": {
          "BANNER_OUTPUT_PATH": "src/content/banner.json",
          "BANNER_ENV_VAR": "BANNER_URL"
        }
      }
    },
    "serve": {
      "continuous": true,
      "dependsOn": [
        "prebuild-banner",
        {
          "projects": [
            "nx",
            "devkit",
            "create-nx-workspace",
            "dotnet",
            "maven",
            "esbuild",
            "gradle",
            "nuxt",
            "@nx/oxlint",
            "plugin",
            "react-native",
            "remix"
          ],
          "target": "build"
        }
      ],
      "command": "astro dev",
      "options": {
        "cwd": "astro-docs"
      }
    },
    "build": {
      "cache": false,
      "//": "The Public API collection reads a live OpenAPI spec, which can change without a repository change.",
      "dependsOn": [
        "prebuild-banner",
        "prebuild-agent-skills",
        {
          "projects": [
            "nx",
            "devkit",
            "create-nx-workspace",
            "dotnet",
            "maven",
            "esbuild",
            "gradle",
            "nuxt",
            "@nx/oxlint",
            "plugin",
            "react-native",
            "remix"
          ],
          "target": "build"
        }
      ],
      "inputs": [
        "production",
        "^production",
        "{projectRoot}/src/content/banner.json",
        "{projectRoot}/netlify.toml",
        { "env": "NX_DEV_URL" },
        "{workspaceRoot}/packages/*/package.json",
        "{workspaceRoot}/packages/*/{generators,executors,migrations}.json",
        "{workspaceRoot}/packages/*/src/{generators,executors}/**/schema.json",
        "{workspaceRoot}/packages/*/src/migrations/**/*.md",
        "{workspaceRoot}/packages/*/docs/**/*.md",
        {
          "json": "{workspaceRoot}/tsconfig.json",
          "fields": ["compilerOptions"]
        },
        {
          "dependentTasksOutputFiles": "**/*.{d.ts,json,md,js,cjs,mjs}",
          "transitive": true
        }
      ],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/.astro",
        "{projectRoot}/.netlify"
      ],
      "command": "astro build",
      "options": {
        "cwd": "astro-docs"
      }
    },
    "preview": {
      "dependsOn": ["build"],
      "command": "astro preview",
      "inputs": [
        "default",
        "{workspaceRoot}/packages/*/package.json",
        "{workspaceRoot}/packages/*/{generators,executors,migrations}.json",
        { "externalDependencies": ["astro"] },
        { "dependentTasksOutputFiles": "**/*" }
      ],
      "continuous": true,
      "options": {
        "cwd": "astro-docs"
      }
    },
    "astro": {
      "command": "astro",
      "options": {
        "cwd": "astro-docs"
      }
    },
    "test": {
      "executor": "nx:noop",
      "inputs": [],
      "dependsOn": ["validate-links", "format", "test-openapi"]
    },
    "test-openapi": {
      "command": "node --import tsx --test src/plugins/nx-cloud-public-api.loader.test.ts",
      "options": {
        "cwd": "astro-docs"
      }
    },
    "pw-e2e": {
      "dependsOn": ["serve"],
      "parallelism": true
    },
    "e2e-ci--**/*": {
      "dependsOn": ["preview"],
      "parallelism": true,
      "options": {
        "args": []
      }
    },
    "show-report": {
      "command": "playwright show-report dist/astro-docs/playwright-report"
    },
    "validate-links": {
      "dependsOn": ["build", "nx-dev:build"],
      "cache": true,
      "inputs": [
        "{projectRoot}/validate-links.ts",
        { "dependentTasksOutputFiles": "**/*.html" },
        { "dependentTasksOutputFiles": "**/sitemap*.xml" },
        "{projectRoot}/src/**/*",
        "{projectRoot}/astro.config.mjs",
        "{projectRoot}/sidebar.mts",
        "{projectRoot}/markdoc.config.mjs",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/package.json"
      ],
      "command": "tsx validate-links.ts",
      "options": {
        "cwd": "astro-docs"
      }
    },
    "vale": {
      "command": "node scripts/vale-changed.mjs",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/content/docs/**/*.mdoc",
        "{projectRoot}/src/content/docs/**/*.mdx",
        "{projectRoot}/src/content/docs/**/*.md",
        "{projectRoot}/.vale.ini",
        "{projectRoot}/.vale/styles/**/*",
        "{projectRoot}/scripts/vale-changed.mjs"
      ]
    },
    "vale:all": {
      "command": "node scripts/vale-changed.mjs --all",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{projectRoot}/src/content/docs/**/*.mdoc",
        "{projectRoot}/src/content/docs/**/*.mdx",
        "{projectRoot}/src/content/docs/**/*.md",
        "{projectRoot}/.vale.ini",
        "{projectRoot}/.vale/styles/**/*",
        "{projectRoot}/scripts/vale-changed.mjs"
      ]
    },
    "prebuild-agent-skills": {
      "cache": false,
      "inputs": [
        "{projectRoot}/scripts/sync-agent-skills.mjs",
        { "env": "NETLIFY" }
      ],
      "outputs": ["{projectRoot}/public/.well-known/agent-skills"],
      "command": "node scripts/sync-agent-skills.mjs",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "format": {
      "cache": true,
      "//": "oxfmt only formats extensions it knows, so the script mirrors .mdoc files as .md into a temp dir for one oxfmt run",
      "command": "node scripts/format-mdoc.mjs --check",
      "options": {
        "cwd": "astro-docs"
      },
      "inputs": [
        "{projectRoot}/**/*.mdoc",
        "{projectRoot}/scripts/format-mdoc.mjs",
        "{workspaceRoot}/.oxfmtrc.json",
        "{workspaceRoot}/.editorconfig"
      ]
    },
    "format:write": {
      "command": "node scripts/format-mdoc.mjs",
      "options": {
        "cwd": "astro-docs"
      }
    }
  }
}
