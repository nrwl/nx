---
// Copied from @astrojs/starlight@0.42.0 components/PageFrame.astro with modifications.
import MobileMenuToggle from '@astrojs/starlight/components/MobileMenuToggle.astro';
import { GitHubStarWidget } from '@nx/nx-dev-ui-common/src/lib/github-star-widget';
import { WebinarNotifier } from '@nx/nx-dev-ui-common/src/lib/webinar-notifier';
import { getCollection } from 'astro:content';
import SiteFooter from './site-nav/SiteFooter.astro';
import SiteNavLinks from './site-nav/SiteNavLinks.astro';
import TopBanner from './TopBanner.astro';
import { isBannerActive, withUtmSource } from './top-banner';

const { hasSidebar } = Astro.locals.starlightRoute;
const githubStarsCount = Astro.locals.githubStarsCount ?? 0;

const bannerCollection = await getCollection('banner');
const bannerConfig = bannerCollection[0]?.data;
const showBanner = isBannerActive(bannerConfig?.activeUntil);
const bannerId = bannerConfig ? `${bannerConfig.title}-${bannerConfig.activeUntil || 'no-expiry'}` : '';
---

<div class:list={['page', 'sl-flex', { 'has-top-banner': showBanner }]}>
  {showBanner && bannerConfig && (
    <TopBanner
      title={bannerConfig.title}
      description={bannerConfig.description}
      ctaText={bannerConfig.primaryCtaText}
      url={withUtmSource(bannerConfig.primaryCtaUrl, 'nx-docs')}
    />
  )}
  <header class="header"><slot name="header" /></header>
  {
    hasSidebar && (
      <nav class="sidebar print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
        <MobileMenuToggle />
        <sl-sidebar-pane popover="" id="starlight__sidebar" class="sidebar-pane">
          <div class="sidebar-content sl-flex">
            <slot name="sidebar" />
            <!-- GitHub stars, for screens too narrow for the count in the header -->
            <div class="mt-auto min-[62rem]:hidden">
              <GitHubStarWidget starsCount={githubStarsCount} client:load />
            </div>
            <!-- Phone menu: the nx.dev nav, which the header only has room for from 50rem -->
            <div class="nx-chrome nx-sidebar-site-nav flex flex-col gap-4 bg-[#0C0C0D] pt-2 pb-6 min-[50rem]:hidden">
              <SiteNavLinks mobile />
            </div>
          </div>
        </sl-sidebar-pane>
      </nav>
    )
  }
  <div class="main-frame"><slot /></div>
  <SiteFooter />
  {showBanner && bannerConfig && (
    <WebinarNotifier
      id={bannerId}
      title={bannerConfig.title}
      description={bannerConfig.description}
      artwork={bannerConfig.artwork}
      primaryCtaUrl={bannerConfig.primaryCtaUrl}
      primaryCtaText={bannerConfig.primaryCtaText}
      secondaryCtaUrl={bannerConfig.secondaryCtaUrl}
      secondaryCtaText={bannerConfig.secondaryCtaText}
      activeUntil={bannerConfig.activeUntil}
      client:load
    />
  )}
</div>

<style>
  @layer starlight.core {
    .page {
      flex-direction: column;
      min-height: 100vh;
    }

    .header {
      z-index: var(--sl-z-index-navbar);
      position: fixed;
      inset-inline-start: 0;
      inset-block-start: 0;
      width: 100%;
      height: var(--sl-nav-height);
      padding: 0 var(--sl-nav-pad-x);
      /* Always dark and translucent, like the nx.dev navbar. The light theme
         needs it more opaque to keep the nav readable over a white page. */
      background-color: rgba(12, 12, 13, 0.92);
      -webkit-backdrop-filter: blur(24px);
      backdrop-filter: blur(24px);
    }

    :global([data-theme='dark']) .header {
      background-color: rgba(12, 12, 13, 0.6);
    }

    /* The nx.dev nav at the end of the sidebar menu spans its full width. */
    .nx-sidebar-site-nav {
      margin-inline: calc(var(--sl-sidebar-pad-x) * -1);
      padding-inline: 1.25rem;
    }

    /* Push the fixed header below the banner. */
    .page.has-top-banner .header {
      inset-block-start: var(--top-banner-h);
    }

    :global([data-has-sidebar]) .header {
      padding-inline-end: calc(
        var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
      );
    }

    .sidebar-pane {
      /* User agents apply opinionated styles to popovers, which we don't want. */
      border: unset;
      padding: unset;
      height: unset;
      color: unset;

      position: fixed;
      z-index: var(--sl-z-index-menu);
      inset-block: var(--sl-nav-height) 0;
      inset-inline-start: 0;
      width: 100%;
      background-color: var(--sl-color-bg-sidebar);
      overflow-y: auto;
      scrollbar-gutter: stable;
    }

    .page.has-top-banner .sidebar-pane {
      inset-block-start: calc(var(--sl-nav-height) + var(--top-banner-h));
    }

    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 1rem var(--sl-sidebar-pad-x) 0;
      flex-direction: column;
      gap: 1rem;
    }

    @media (min-width: 72rem) {
      :global(.right-sidebar) {
        height: auto;
      }
    }

    @media (min-width: 50rem) {
      .sidebar-content::after {
        content: '';
        padding-bottom: 1px;
      }
    }

    .main-frame {
      /* Fills short pages, so the dark footer always ends at the bottom. */
      flex-grow: 1;
      padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
      padding-inline-start: var(--sl-content-inline-start);
    }

    .page.has-top-banner .main-frame {
      padding-top: calc(
        var(--sl-nav-height) + var(--sl-mobile-toc-height) +
          var(--top-banner-h)
      );
    }

    /* Starlight's mobile on-this-page bar is fixed at the nav height; shift it too. */
    .page.has-top-banner :global(mobile-starlight-toc > nav) {
      top: calc(var(--sl-nav-height) + var(--top-banner-h));
    }

    /* The fixed mobile menu (hamburger) toggle is positioned from the viewport
       top, so it hides under the top banner unless we clear it too. */
    .page.has-top-banner :global(.sl-menu-button) {
      top: calc(
        (var(--sl-nav-height) - var(--sl-menu-button-size)) / 2 +
          var(--top-banner-h)
      );
    }

    @media (min-width: 50rem) {
      :global([data-has-sidebar]) .header {
        padding-inline-end: var(--sl-nav-pad-x);
      }
      .sidebar-pane {
        /* Visible on larger screens instead of deferring to popover state. */
        display: block;
        width: var(--sl-sidebar-width);
        background-color: var(--sl-color-bg-sidebar);
        border-inline-end: 1px solid var(--sl-color-hairline-shade);
      }
    }

    :global([data-has-sidebar] footer) {
      padding-inline-start: var(--sl-content-inline-start);
    }
  }

  /* Unlayered so it overrides Starlight's layered scroll-padding-top. */
  :global(html:has(.page.has-top-banner)) {
    /* One 18px line plus 8px padding on each side and a 1px border. */
    --top-banner-h: 35px;
    scroll-padding-top: calc(
      1.5rem + var(--sl-nav-height) + var(--sl-mobile-toc-height) +
        var(--top-banner-h)
    );
  }
</style>
