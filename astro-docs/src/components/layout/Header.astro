---
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import NxLogo from './site-nav/NxLogo.astro';
import SiteNavLinks from './site-nav/SiteNavLinks.astro';

// This header mirrors the nx.dev (Framer) navbar: same content, measurements,
// colors and motion, as ported for the blog in nrwl/nx-blog. The docs are
// served under nx.dev/docs, so the two have to look like one site. The search,
// version switcher and theme switcher are the docs-only additions. When the
// Framer navbar changes, update this file too.

/**
 * Render the `Search` component if Pagefind is enabled or the default search component has been overridden.
 */
const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== '@astrojs/starlight/components/Search.astro';

// Version options
const versions = [
  { version: 'v23', href: '/docs/getting-started/intro', current: true },
  { version: 'v22', href: 'https://22.nx.dev/docs' },
  { version: 'v21', href: 'https://21.nx.dev/docs' },
  { version: 'v20', href: 'https://20.nx.dev/docs' },
  { version: 'v19', href: 'https://19.nx.dev/docs' },
];

const currentVersion = versions.find((v) => v.current);

const themes = [
  { value: 'light', label: 'Switch to light theme' },
  { value: 'dark', label: 'Switch to dark theme' },
  { value: 'auto', label: 'Use system theme' },
];
---

<div class="nx-chrome nx-header flex h-full items-center justify-center">
  <div class="flex w-full max-w-[1340px] items-center justify-between gap-3">
    <div class="flex flex-none items-center gap-3">
      <a href="https://nx.dev" class="flex no-underline">
        <NxLogo class="block h-6 w-[45px]" />
      </a>
      <!-- Version Switcher -->
      <div class="nx-header-version relative">
        <button
          class="version-trigger flex items-center gap-1 rounded-full bg-transparent py-1 pr-1.5 pl-2.5 text-[13px] leading-[1.2] font-medium text-[#A3A3A8] shadow-[inset_0_0_0_1px_#28282A] transition-colors duration-200 hover:text-[#FAFAFA]"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>{currentVersion?.version}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="version-icon h-3 w-3 transition-transform"
          >
            <path
              fill-rule="evenodd"
              d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
              clip-rule="evenodd"></path>
          </svg>
        </button>
        <div
          class="version-menu invisible absolute top-full left-0 z-50 mt-2 min-w-[7rem] translate-y-1 rounded-[12px] bg-[#19191A] p-1 opacity-0 shadow-[inset_0_0_0_1px_#28282A] transition-all"
        >
          {
            versions.map((item) => (
              <a
                href={item.href}
                class={`flex items-center justify-between rounded-[8px] px-3 py-2 text-[14px] leading-[1.2] font-medium no-underline transition-colors duration-200 hover:bg-[#28282A] ${item.current ? 'text-[#FAFAFA]' : 'text-[#D5D5D7]'}`}
                aria-current={item.current ? 'page' : undefined}
              >
                {item.version}
                {item.current && <span aria-hidden="true">✓</span>}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="flex min-w-0 items-center gap-3">
      <div class="nx-header-controls flex items-center gap-3 print:hidden">
        {shouldRenderSearch && <Search />}
        <div
          class="nx-theme-toggle flex items-center gap-1"
          role="group"
          aria-label="Theme"
        >
          {
            themes.map((theme) => (
              <button
                type="button"
                data-theme-value={theme.value}
                aria-label={theme.label}
                aria-pressed="false"
                class="flex rounded bg-transparent p-[2px] text-[#73737B] transition-colors duration-200 hover:text-[#D5D5D7] aria-pressed:text-[#FAFAFA]"
              >
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  {theme.value === 'light' && (
                    <>
                      <circle cx="12" cy="12" r="5" />
                      <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
                    </>
                  )}
                  {theme.value === 'dark' && (
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                  )}
                  {theme.value === 'auto' && (
                    <>
                      <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
                      <path d="M8 21h8M12 17v4" />
                    </>
                  )}
                </svg>
              </button>
            ))
          }
          <!-- Starlight's own picker keeps owning the theme state. -->
          <div hidden><ThemeSelect /></div>
        </div>
      </div>
      <nav
        class="nx-header-nav hidden flex-none items-center gap-3 print:hidden"
        aria-label="Nx"
      >
        <SiteNavLinks />
      </nav>
    </div>
  </div>
</div>

<style>
  /* The site nav needs 50rem, the same width at which Starlight shows the
     sidebar next to the content. Below that it lives in the sidebar menu. */
  @media (min-width: 50rem) {
    .nx-header-nav {
      display: flex;
    }
  }

  /* nx.dev keeps its full nav down to 50rem, where the docs controls no longer
     fit next to it. In that band the version switcher and the "Get Started"
     pill (the same link as "Docs") step aside. */
  @media (min-width: 50rem) and (max-width: 61.999rem) {
    .nx-header-version,
    .nx-header-nav :global(#header-get-started-btn) {
      display: none;
    }

    .nx-header-controls {
      gap: 0.5rem;
    }
  }

  /* Starlight's search button, fitted into the nx.dev chrome: an icon on
     narrow screens, a pill-shaped field from 75rem. */
  .nx-header-controls :global(button[data-open-modal]) {
    width: 2.25rem;
    max-width: none;
    height: 2.25rem;
    flex: none;
    justify-content: center;
    border: 0;
    border-radius: 999px;
    padding: 0;
    background-color: transparent;
    color: #d5d5d7;
    font-family: inherit;
    font-size: 1rem;
    transition:
      color 0.2s,
      box-shadow 0.2s;
  }

  .nx-header-controls :global(button[data-open-modal]:hover) {
    color: #fafafa;
  }

  .nx-header-controls :global(button[data-open-modal] > span),
  .nx-header-controls :global(button[data-open-modal] > kbd) {
    display: none !important;
  }

  @media (min-width: 75rem) {
    .nx-header-controls :global(button[data-open-modal]) {
      width: 14rem;
      justify-content: flex-start;
      gap: 0.5rem;
      padding-inline: 0.875rem 0.5rem;
      background-color: #19191a;
      box-shadow: inset 0 0 0 1px #28282a;
      color: #a3a3a8;
      font-size: 0.875rem;
    }

    .nx-header-controls :global(button[data-open-modal]:hover) {
      box-shadow: inset 0 0 0 1px #404044;
    }

    .nx-header-controls :global(button[data-open-modal] > span) {
      display: block !important;
    }

    .nx-header-controls :global(button[data-open-modal] > kbd) {
      display: flex !important;
      margin-inline-start: auto;
      border-radius: 999px;
      padding-inline: 0.5rem;
      background-color: #28282a;
      color: #a3a3a8;
    }
  }
</style>

<script>
  import { sendCustomEventViaGtm } from '@nx/nx-dev-feature-analytics';

  function setupAnalyticsTracking() {
    const track = (id: string, event: string, category: string) =>
      document.getElementById(id)?.addEventListener('click', () => {
        sendCustomEventViaGtm(event, category, 'documentation-header');
      });

    track('header-docs-home-link', 'documentation-click', 'header-navigation');
    track('header-nx-cloud-link', 'nx-cloud-click', 'header-navigation');
    track('header-pricing-link', 'pricing-click', 'header-navigation');
    track('header-contact-btn', 'contact-click', 'header-cta');
    track('header-get-started-btn', 'get-started-click', 'header-cta');
  }

  function setupThemeToggle() {
    const toggle = document.querySelector('.nx-theme-toggle');
    const select = toggle?.querySelector('select');
    if (!toggle || !select) return;

    const buttons = toggle.querySelectorAll<HTMLButtonElement>(
      'button[data-theme-value]'
    );
    const sync = () =>
      buttons.forEach((button) =>
        button.setAttribute(
          'aria-pressed',
          String(button.dataset.themeValue === select.value)
        )
      );

    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        select.value = button.dataset.themeValue ?? 'auto';
        select.dispatchEvent(new Event('change', { bubbles: true }));
        sync();
      })
    );
    sync();
  }

  function setupVersionSwitcher() {
    const versionSwitcher =
      document.querySelector('.version-trigger')?.parentElement;
    const versionTrigger =
      versionSwitcher?.querySelector('.version-trigger') ?? null;
    const versionMenu = versionSwitcher?.querySelector('.version-menu') ?? null;

    versionTrigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = versionTrigger.getAttribute('aria-expanded') === 'true';
      versionTrigger.setAttribute('aria-expanded', (!isOpen).toString());
      if (isOpen) {
        versionMenu?.classList.add('opacity-0', 'invisible', 'translate-y-1');
        versionMenu?.classList.remove(
          'opacity-100',
          'visible',
          'translate-y-0'
        );
        versionTrigger
          .querySelector('.version-icon')
          ?.classList.remove('rotate-180');
      } else {
        versionMenu?.classList.remove(
          'opacity-0',
          'invisible',
          'translate-y-1'
        );
        versionMenu?.classList.add('opacity-100', 'visible', 'translate-y-0');
        versionTrigger
          .querySelector('.version-icon')
          ?.classList.add('rotate-180');
      }
    });

    // Close version switcher when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (
        !target.closest('.version-trigger') &&
        !target.closest('.version-menu')
      ) {
        versionTrigger?.setAttribute('aria-expanded', 'false');
        versionMenu?.classList.add('opacity-0', 'invisible', 'translate-y-1');
        versionMenu?.classList.remove(
          'opacity-100',
          'visible',
          'translate-y-0'
        );
        versionTrigger
          ?.querySelector('.version-icon')
          ?.classList.remove('rotate-180');
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    setupAnalyticsTracking();
    setupThemeToggle();
    setupVersionSwitcher();
  });
</script>
