---
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import NxLogo from './site-nav/NxLogo.astro';
import SiteNavLinks from './site-nav/SiteNavLinks.astro';

// This header carries the nx.dev (Framer) navbar's look into the docs: same
// logo, entries, type, colors and menus, as ported for the blog in
// nrwl/nx-blog. The arrangement is the docs' own: logo, version and the whole
// nav on the left, in line with the sidebar below, and search, GitHub stars
// and the theme toggle on the right. When the Framer navbar changes, update
// this file too.

/**
 * Render the `Search` component if Pagefind is enabled or the default search component has been overridden.
 */
const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== '@astrojs/starlight/components/Search.astro';

// Version options
const versions = [
  { version: 'v23', href: '/docs/getting-started/intro', current: true },
  { version: 'v22', href: 'https://22.nx.dev/docs' },
  { version: 'v21', href: 'https://21.nx.dev/docs' },
  { version: 'v20', href: 'https://20.nx.dev/docs' },
  { version: 'v19', href: 'https://19.nx.dev/docs' },
];

const currentVersion = versions.find((v) => v.current);

const themes = [
  { value: 'light', label: 'Switch to light theme' },
  { value: 'auto', label: 'Use system theme' },
  { value: 'dark', label: 'Switch to dark theme' },
];

// Same wording as the star count on the nx.dev homepage: "+29k stars".
const githubStarsCount = Astro.locals.githubStarsCount ?? 0;
const githubStarsLabel =
  githubStarsCount >= 1000
    ? `+${Math.floor(githubStarsCount / 1000)}k stars`
    : 'Star on GitHub';
---

<div class="nx-chrome nx-header flex h-full items-center">
  <div class="flex w-full items-center justify-between gap-3">
    <div class="flex flex-none items-center gap-3">
      <a href="https://nx.dev" class="flex no-underline">
        <NxLogo class="block h-6 w-[45px]" />
      </a>
      <!-- Version Switcher -->
      <div class="nx-header-version relative">
        <button
          class="version-trigger flex items-center gap-1 rounded-full bg-transparent py-1 pr-1.5 pl-2.5 text-[13px] leading-[1.2] font-medium text-[#A3A3A8] shadow-[inset_0_0_0_1px_#28282A] transition-colors duration-200 hover:text-[#FAFAFA]"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>{currentVersion?.version}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="version-icon h-3 w-3 transition-transform"
          >
            <path
              fill-rule="evenodd"
              d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
              clip-rule="evenodd"></path>
          </svg>
        </button>
        <div
          class="version-menu invisible absolute top-full left-0 z-50 mt-2 min-w-[7rem] translate-y-1 rounded-[12px] bg-[#19191A] p-1 opacity-0 shadow-[inset_0_0_0_1px_#28282A] transition-all"
        >
          {
            versions.map((item) => (
              <a
                href={item.href}
                class={`flex items-center justify-between rounded-[8px] px-3 py-2 text-[14px] leading-[1.2] font-medium no-underline transition-colors duration-200 hover:bg-[#28282A] ${item.current ? 'text-[#FAFAFA]' : 'text-[#D5D5D7]'}`}
                aria-current={item.current ? 'page' : undefined}
              >
                {item.version}
                {item.current && <span aria-hidden="true">✓</span>}
              </a>
            ))
          }
        </div>
      </div>
      <nav
        class="nx-header-nav hidden flex-none items-center print:hidden"
        aria-label="Nx"
      >
        <SiteNavLinks />
      </nav>
    </div>

    <div class="flex min-w-0 items-center gap-3">
      <div class="nx-header-controls flex items-center gap-3 print:hidden">
        {shouldRenderSearch && <Search />}
        <a
          id="header-github-stars"
          href="https://github.com/nrwl/nx"
          target="_blank"
          rel="noreferrer noopener"
          class="nx-header-stars hidden items-center gap-2 text-[14px] leading-[1.2] font-medium whitespace-nowrap text-[#A3A3A8] no-underline transition-colors duration-200 hover:text-[#FAFAFA]"
        >
          <svg
            class="h-4 w-4 text-[#FAFAFA]"
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38l-.01-1.49c-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48l-.01 2.2c0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8a8 8 0 0 0-8-8z" />
          </svg>
          <span>{githubStarsLabel}</span>
          <span class="sr-only">on GitHub</span>
        </a>
        <!-- At rest only the active theme's icon shows. Hovering or focusing
             the group expands the other two. -->
        <div class="nx-theme-slot">
          <div class="nx-theme-toggle" role="group" aria-label="Theme">
            {
              themes.map((theme) => (
                <button
                  type="button"
                  data-theme-value={theme.value}
                  aria-label={theme.label}
                  aria-pressed="false"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    {theme.value === 'light' && (
                      <>
                        <circle cx="12" cy="12" r="5" />
                        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
                      </>
                    )}
                    {theme.value === 'dark' && (
                      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                    )}
                    {theme.value === 'auto' && (
                      <>
                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
                        <path d="M8 21h8M12 17v4" />
                      </>
                    )}
                  </svg>
                </button>
              ))
            }
            <!-- Starlight's own picker keeps owning the theme state. -->
            <div hidden><ThemeSelect /></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* The site nav needs 50rem, the same width at which Starlight shows the
     sidebar next to the content. Below that it lives in the sidebar menu. */
  @media (min-width: 50rem) {
    .nx-header-nav {
      display: flex;
    }
  }

  /* Just above 50rem the nav leaves no room for the version switcher. */
  @media (min-width: 50rem) and (max-width: 61.999rem) {
    .nx-header-version {
      display: none;
    }
  }

  /* The star count needs the room that opens up from 62rem. */
  @media (min-width: 62rem) {
    .nx-header-stars {
      display: flex;
    }
  }

  .nx-theme-slot {
    display: flex;
    flex: none;
  }

  .nx-theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    border-radius: 999px;
    padding: 2px;
    box-shadow: inset 0 0 0 1px transparent;
    transition:
      box-shadow 0.15s ease-out,
      background-color 0.15s ease-out;
  }

  .nx-theme-toggle:hover,
  .nx-theme-toggle:focus-within {
    background-color: #19191a;
    box-shadow: inset 0 0 0 1px #28282a;
  }

  .nx-theme-toggle button {
    display: inline-flex;
    width: 24px;
    height: 24px;
    flex: none;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 0;
    border-radius: 999px;
    padding: 0;
    background: transparent;
    color: #a3a3a8;
    cursor: pointer;
    transition:
      width 0.15s ease-out,
      opacity 0.15s ease-out,
      color 0.15s ease-out;
  }

  .nx-theme-toggle button svg {
    width: 16px;
    height: 16px;
    flex: none;
  }

  .nx-theme-toggle button:hover,
  .nx-theme-toggle button[aria-pressed='true'] {
    color: #fafafa;
  }

  /* Inactive options collapse away unless the group is hovered or focused. */
  .nx-theme-toggle button:not([aria-pressed='true']) {
    width: 0;
    margin-inline: -1px;
    opacity: 0;
    pointer-events: none;
  }

  .nx-theme-toggle:hover button:not([aria-pressed='true']),
  .nx-theme-toggle:focus-within button:not([aria-pressed='true']) {
    width: 24px;
    margin-inline: 0;
    opacity: 1;
    pointer-events: auto;
  }

  /* Starlight's search button, fitted into the nx.dev chrome: an icon on
     narrow screens, a pill-shaped field from 75rem. */
  .nx-header-controls :global(button[data-open-modal]) {
    width: 2.25rem;
    max-width: none;
    height: 2.25rem;
    flex: none;
    justify-content: center;
    border: 0;
    border-radius: 999px;
    padding: 0;
    background-color: transparent;
    color: #d5d5d7;
    font-family: inherit;
    font-size: 1rem;
    transition:
      color 0.2s,
      box-shadow 0.2s;
  }

  .nx-header-controls :global(button[data-open-modal]:hover) {
    color: #fafafa;
  }

  .nx-header-controls :global(button[data-open-modal] > span),
  .nx-header-controls :global(button[data-open-modal] > kbd) {
    display: none !important;
  }

  @media (min-width: 75rem) {
    .nx-header-controls :global(button[data-open-modal]) {
      width: 14rem;
      justify-content: flex-start;
      gap: 0.5rem;
      padding-inline: 0.875rem 0.5rem;
      background-color: #19191a;
      box-shadow: inset 0 0 0 1px #28282a;
      color: #a3a3a8;
      font-size: 0.875rem;
    }

    .nx-header-controls :global(button[data-open-modal]:hover) {
      box-shadow: inset 0 0 0 1px #404044;
    }

    .nx-header-controls :global(button[data-open-modal] > span) {
      display: block !important;
    }

    .nx-header-controls :global(button[data-open-modal] > kbd) {
      display: flex !important;
      margin-inline-start: auto;
      border-radius: 999px;
      padding-inline: 0.5rem;
      background-color: #28282a;
      color: #a3a3a8;
    }
  }
</style>

<script>
  import { sendCustomEventViaGtm } from '@nx/nx-dev-feature-analytics';

  function setupAnalyticsTracking() {
    const track = (id: string, event: string, category: string) =>
      document.getElementById(id)?.addEventListener('click', () => {
        sendCustomEventViaGtm(event, category, 'documentation-header');
      });

    track('header-docs-home-link', 'documentation-click', 'header-navigation');
    track('header-nx-cloud-link', 'nx-cloud-click', 'header-navigation');
    track('header-pricing-link', 'pricing-click', 'header-navigation');
    track('header-contact-btn', 'contact-click', 'header-navigation');
    track('header-github-stars', 'githubstars_buttonclick', 'header-navigation');
  }

  function setupThemeToggle() {
    const toggle = document.querySelector('.nx-theme-toggle');
    const select = toggle?.querySelector('select');
    if (!toggle || !select) return;

    const buttons = toggle.querySelectorAll<HTMLButtonElement>(
      'button[data-theme-value]'
    );
    const sync = () =>
      buttons.forEach((button) =>
        button.setAttribute(
          'aria-pressed',
          String(button.dataset.themeValue === select.value)
        )
      );

    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        select.value = button.dataset.themeValue ?? 'auto';
        select.dispatchEvent(new Event('change', { bubbles: true }));
        sync();
      })
    );
    sync();
  }

  function setupVersionSwitcher() {
    const versionSwitcher =
      document.querySelector('.version-trigger')?.parentElement;
    const versionTrigger =
      versionSwitcher?.querySelector('.version-trigger') ?? null;
    const versionMenu = versionSwitcher?.querySelector('.version-menu') ?? null;

    versionTrigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = versionTrigger.getAttribute('aria-expanded') === 'true';
      versionTrigger.setAttribute('aria-expanded', (!isOpen).toString());
      if (isOpen) {
        versionMenu?.classList.add('opacity-0', 'invisible', 'translate-y-1');
        versionMenu?.classList.remove(
          'opacity-100',
          'visible',
          'translate-y-0'
        );
        versionTrigger
          .querySelector('.version-icon')
          ?.classList.remove('rotate-180');
      } else {
        versionMenu?.classList.remove(
          'opacity-0',
          'invisible',
          'translate-y-1'
        );
        versionMenu?.classList.add('opacity-100', 'visible', 'translate-y-0');
        versionTrigger
          .querySelector('.version-icon')
          ?.classList.add('rotate-180');
      }
    });

    // Close version switcher when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (
        !target.closest('.version-trigger') &&
        !target.closest('.version-menu')
      ) {
        versionTrigger?.setAttribute('aria-expanded', 'false');
        versionMenu?.classList.add('opacity-0', 'invisible', 'translate-y-1');
        versionMenu?.classList.remove(
          'opacity-100',
          'visible',
          'translate-y-0'
        );
        versionTrigger
          ?.querySelector('.version-icon')
          ?.classList.remove('rotate-180');
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    setupAnalyticsTracking();
    setupThemeToggle();
    setupVersionSwitcher();
  });
</script>
