## AngularRspackPluginOptions

The `AngularRspackPluginOptions` object is an object that contains the following properties:

```ts
export interface AngularRspackPluginOptions extends PluginUnsupportedOptions {
  aot?: boolean;
  assets?: AssetElement[];
  browser?: string;
  commonChunk?: boolean;
  devServer?: DevServerOptions;
  extractLicenses?: boolean;
  fileReplacements?: FileReplacement[];
  index?: IndexElement;
  inlineStyleLanguage?: InlineStyleLanguage;
  namedChunks?: boolean;
  optimization?: boolean | OptimizationOptions;
  outputHashing?: OutputHashing;
  outputMode?: 'server' | 'static';
  outputPath?:
    | string
    | (Required<Pick<OutputPath, 'base'>> & Partial<OutputPath>);
  polyfills?: string[];
  root?: string;
  scripts?: ScriptOrStyleEntry[];
  security?: {
    allowedHosts?: string[];
    autoCsp?: boolean | { unsafeEval?: boolean };
  };
  server?: string;
  skipTypeChecking?: boolean;
  sourceMap?: boolean | Partial<SourceMap>;
  ssr?:
    | boolean
    | {
        entry: string;
        platform?: 'node' | 'neutral';
        // Deprecated. Use `platform` instead.
        experimentalPlatform?: 'node' | 'neutral';
        serveFromDevServer?: boolean;
      };
  stylePreprocessorOptions?: StylePreprocessorOptions;
  styles?: ScriptOrStyleEntry[];
  tsConfig?: string;
  useTsProjectReferences?: boolean;
  vendorChunk?: boolean;
}

export interface DevServerOptions extends DevServerUnsupportedOptions {
  port?: number;
  ssl?: boolean;
  sslKey?: string;
  sslCert?: string;
  proxyConfig?: string;
}

export interface OptimizationOptions {
  scripts?: boolean;
  styles?: boolean;
  fonts?: boolean;
}

export type OutputHashing = 'none' | 'all' | 'media' | 'bundles';
export type HashFormat = {
  chunk: string;
  extract: string;
  file: string;
  script: string;
};

export interface OutputPath {
  base: string;
  browser: string;
  server: string;
  media: string;
}

export type AssetExpandedDefinition = {
  glob: string;
  input: string;
  ignore?: string[];
  output?: string;
};
export type AssetElement = AssetExpandedDefinition | string;
export type NormalizedAssetElement = AssetExpandedDefinition & {
  output: string;
};
export type ScriptOrStyleEntry =
  | string
  | {
      input: string;
      bundleName?: string;
      inject?: boolean;
    };
export type GlobalEntry = {
  name: string;
  files: string[];
  initial: boolean;
};
export type IndexExpandedDefinition = {
  input: string;
  output?: string;
  preloadInitial?: boolean;
};
export type IndexElement = IndexExpandedDefinition | string | false;
export type IndexHtmlTransform = (content: string) => Promise<string>;
export type NormalizedIndexElement =
  | (IndexExpandedDefinition & {
      insertionOrder: [string, boolean][];
      transformer: IndexHtmlTransform | undefined;
    })
  | false;

export interface SourceMap {
  scripts: boolean;
  styles: boolean;
  hidden: boolean;
  vendor: boolean;
}

export type InlineStyleExtension = 'css' | 'scss' | 'sass' | 'less';
export interface FileReplacement {
  replace: string;
  with: string;
}
export interface StylePreprocessorOptions {
  includePaths?: string[];
  sass?: Sass;
}
export interface Sass {
  fatalDeprecations?: DeprecationOrId[];
  futureDeprecations?: DeprecationOrId[];
  silenceDeprecations?: DeprecationOrId[];
}
```

---

### aot

`boolean` `default: true`
Enables or disables Ahead-of-Time compilation for Angular applications.

### assets

`AssetElement[]`
Array of static assets to include in the build output. Can be either a string path or an object with glob patterns.

### browser

`string`
The entry point file for the browser bundle (e.g., 'src/main.ts').

### commonChunk

`boolean` `default: true`
Controls whether to create a separate bundle containing shared code between multiple chunks.

### devServer

`DevServerOptions`
Configuration options for the development server including port, SSL settings, and proxy configuration.

Pages on these origins can read the development server responses: `localhost`, its subdomains,
`127.0.0.1`, and `[::1]`, over `http` or `https` on any port.
For another origin, such as a local network address or a custom hostname, set
`Access-Control-Allow-Origin` in `devServer.headers`.

### extractLicenses

`boolean` `default: false`
When true, extracts all license information from dependencies into a separate file.

### fileReplacements

`FileReplacement[]`
List of files to be replaced during the build process, typically used for environment-specific configurations.

### index

`IndexElement`
Configuration for the index.html file. Can be a string path, an object with specific settings, or false to disable.

### inlineStyleLanguage

`InlineStyleLanguage`
Specifies the default language to use for inline styles in components.

### namedChunks

`boolean` `default: true`
When true, generates named chunks instead of numerical IDs.

### optimization

`boolean | OptimizationOptions` `default: true`
Controls build optimization settings for scripts, styles, and fonts.

### outputHashing

`OutputHashing` `default: 'none'`
Defines the hashing strategy for output files. Can be 'none', 'all', 'media', or 'bundles'.

### outputMode

`'server' | 'static'`
Defines the build output target for server-side rendered applications.
Only `server` is currently supported.
The `static` mode (build-time prerendering of the full application) is rejected.

### outputPath

`string | OutputPath`
Specifies the output directory for built files. Can be a string or an object defining paths for browser, server, and media files.

### polyfills

`string[]`
Array of polyfill files to include in the build.

### root

`string`
The root directory of the project where the rspack.config.ts file is located.

### scripts

`ScriptOrStyleEntry[]`
Array of global scripts to include in the build, with options for bundling and injection.

### security

`{ allowedHosts?: string[]; autoCsp?: boolean | { unsafeEval?: boolean } }`
Security features for the server-side application.
`allowedHosts` lists the hostnames the `@angular/ssr` application engine accepts.
A non-empty list in an SSR build requires `@angular/ssr` 21.2.0 or greater.
It is also available from 20.3.17 within Angular 20 and from 21.1.5 within Angular 21.1.
Enabling `autoCsp` is not supported yet and is rejected.

### server

`string`
The entry point file for the server bundle in SSR applications.

### skipTypeChecking

`boolean` `default: false`
When true, skips TypeScript type checking during the build process.

### sourceMap

`boolean | Partial<SourceMap>` `default: false`
Controls generation of source maps for debugging. Can be boolean or detailed configuration object.

### ssr

`boolean | { entry: string; platform?: 'node' | 'neutral'; serveFromDevServer?: boolean }`
Configuration for Server-Side Rendering. Can be boolean or object with specific SSR settings. The `experimentalPlatform` option is deprecated; use `platform` instead.

`serveFromDevServer` sets where `rspack serve` renders pages:

- `true`: the dev server renders pages at its own URL.
  It loads the server bundle and calls the `reqHandler` that `entry` exports, when
  `createNodeRequestHandler` from `@angular/ssr/node` or `createRequestHandler` from `@angular/ssr` created it.
  Otherwise it renders pages without that handler and doesn't serve the routes that `entry` adds, such as API routes.
  After each server build, it loads the bundle again, so the top-level code in `entry` runs again.
  `isMainModule(import.meta.url)` returns `false` in the bundle, so the `app.listen` block of generated applications doesn't run.
  Applications that the `@nx/angular` generators create set it.
  The `@nx/angular:convert-to-rspack` generator sets it when `entry` creates its own `reqHandler`
  export with one of those functions.
  Each file that replaces `entry` in `fileReplacements` must create its own `reqHandler` export the same way.
- Not set: `rspack serve` runs the server bundle as a separate server.
  It listens on the port that `entry` sets, `PORT` or 4000 in generated applications.
  The dev-server URL serves the client-rendered application.
  This mode is deprecated, and `rspack serve` prints a warning for it.

Nx 25 removes the option and always renders pages on the dev server.

### stylePreprocessorOptions

`StylePreprocessorOptions`
Options for style preprocessors, including include paths and Sass-specific configurations.

### styles

`ScriptOrStyleEntry[]`
Array of global styles to include in the build, with options for bundling and injection.

### tsConfig

`string`
Path to the TypeScript configuration file.

### useTsProjectReferences

`boolean` `default: false`
Enables usage of TypeScript project references.

### vendorChunk

`boolean` `default: true`
When true, creates a separate bundle for vendor (third-party) code.
