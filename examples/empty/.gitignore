# This example is a scratch workspace for exercising generators, so anything
# generated inside it is ignored and only the files defining the workspace are
# tracked. Those tracked files still get modified by a generator run — reset
# them with `git checkout -- examples/empty`.
#
# Paths are anchored with a leading slash so they match only this directory:
# a bare `package.json` would also re-include every generated project's own.
*
!*/
!/.gitignore
!/README.md
!/nx.json
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/.vscode/extensions.json
node_modules/
.nx/

# Appended by generators; kept here so they leave this file alone.
vite.config.*.timestamp*
vitest.config.*.timestamp*
test-output
