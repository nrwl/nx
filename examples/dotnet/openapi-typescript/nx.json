{
  "$schema": "../../../node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": []
  },
  "plugins": [
    {
      "plugin": "@nx/dotnet",
      "options": {
        "build": {
          "dependsOn": ["...", "restore"],
          "outputs": ["...", "{projectRoot}/openapi"]
        }
      }
    }
  ],
  "analytics": false,
  "neverConnectToCloud": true
}
