{
  "name": "api-client",
  "targets": {
    "compile": {
      "command": "tsc -p libs/api-client/tsconfig.json",
      "dependsOn": ["Api:codegen"],
      "inputs": [
        "{projectRoot}/**/*",
        {
          "dependentTasksOutputFiles": "**/*"
        }
      ],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    }
  }
}
