{
  "name": "Api",
  "targets": {
    "codegen": {
      "command": "openapi-generator-cli generate -g typescript-fetch -i apps/Api/openapi/Api.json -o libs/api-client/src/generated",
      "dependsOn": ["build"],
      "inputs": [{ "dependentTasksOutputFiles": "**/*" }],
      "outputs": ["{workspaceRoot}/libs/api-client/src/generated"],
      "cache": true
    }
  }
}
