#!/usr/bin/env node

import { sep } from 'node:path';
import { createWorkspace } from 'create-nx-workspace';

const packageManagers = ['pnpm', 'yarn', 'npm', 'bun'] as const;
type PackageManager = (typeof packageManagers)[number];

/**
 * Mirrors `create-nx-workspace`: an explicit `--packageManager` wins, otherwise
 * the manager that invoked this CLI, otherwise npm. Choosing at run time keeps
 * the published CLI usable under whichever manager the consumer actually has
 * installed, rather than the one the plugin author generated it from.
 */
function determinePackageManager(explicit: string | undefined): PackageManager {
  if (explicit) {
    if (!(packageManagers as readonly string[]).includes(explicit)) {
      throw new Error(
        `Package manager must be one of ${packageManagers.join(', ')}`
      );
    }
    return explicit as PackageManager;
  }

  const userAgent = process.env.npm_config_user_agent;
  if (userAgent) {
    const invoked = packageManagers.find((pm) =>
      userAgent.startsWith(`${pm}/`)
    );
    if (invoked) {
      return invoked;
    }
  }

  const execPath = process.env.npm_execpath;
  if (execPath) {
    const segments = execPath.split(sep);
    const invoked = packageManagers.find((pm) => segments.includes(pm));
    if (invoked) {
      return invoked;
    }
  }

  return 'npm';
}

/** Reads the workspace name and `--packageManager`/`--pm` out of the argv tail. */
function parseArgs(argv: string[]): {
  name: string | undefined;
  packageManager: string | undefined;
} {
  let name: string | undefined;
  let packageManager: string | undefined;

  for (let i = 0; i < argv.length; i++) {
    const match = /^--(?:packageManager|pm)(?:=(.*))?$/.exec(argv[i]);
    if (match) {
      packageManager = match[1] ?? argv[++i];
    } else if (name === undefined && !argv[i].startsWith('-')) {
      name = argv[i];
    }
  }

  return { name, packageManager };
}

async function main() {
  // TODO: use libraries like yargs, <%= unitTestRunner === 'jest' ? 'enquirer' : '@clack/prompts' %>, or another prompting library to set your workspace name
  const { name, packageManager } = parseArgs(process.argv.slice(2));
  if (!name) {
    throw new Error('Please provide a name for the workspace');
  }

  console.log(`Creating the workspace: ${name}`);

  // This assumes "<%= preset %>" and "<%= projectName %>" are at the same version
  // eslint-disable-next-line @typescript-eslint/no-var-requires<% if (isTsSolutionSetup) { %>
  const presetVersion = require('../../package.json').version;<% } else { %>
  const presetVersion = require('../package.json').version;<% } %>

  // TODO: update below to customize the workspace
  const { directory } = await createWorkspace(
    `<%= preset %>@${presetVersion}`,
    {
      name,
      nxCloud: 'skip',
      packageManager: determinePackageManager(packageManager),
    }
  );

  console.log(`Successfully created the workspace: ${directory}.`);
}

main();
