{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "out-tsc/spec",
    "customConditions": ["@nx/nx-source"],
    "types": ["vitest/globals", "node"],
    "composite": true,
    "rootDir": "."
  },
  "include": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*_spec.ts",
    "**/*_test.ts",
    "**/*.spec.tsx",
    "**/*.test.tsx",
    "**/*.spec.js",
    "**/*.test.js",
    "**/*.spec.jsx",
    "**/*.test.jsx",
    "**/*.d.ts",
    "internal-testing-utils.ts",
    "vitest.config.mts",
    "src/**/*.ts",
    "*.json",
    "migrations.json"
  ],
  "references": [
    {
      "path": "../nx"
    },
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
