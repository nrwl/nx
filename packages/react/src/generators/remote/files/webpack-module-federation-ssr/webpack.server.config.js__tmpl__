const { NxAppWebpackPlugin } = require('@nx/webpack/app-plugin');
const { NxReactWebpackPlugin } = require('@nx/react/webpack-plugin');
const {withModuleFederationForSSR} = require('@nx/module-federation/webpack');

const baseConfig = require("./module-federation.server.config");

const defaultConfig = {
  ...baseConfig,
};

/**
 * DTS Plugin is disabled in Nx Workspaces as Nx already provides Typing support Module Federation
 * The DTS Plugin can be enabled by setting dts: true
 * Learn more about the DTS Plugin here: https://module-federation.io/configure/dts.html
 */
module.exports = async () => {
  const configureFederation = await withModuleFederationForSSR(defaultConfig, { dts: false });
  const webpackConfig = configureFederation({
    mode: process.env.NODE_ENV === 'development' || process.env.NODE_ENV === 'production'
      ? process.env.NODE_ENV
      : 'none',
    entry: {},
    output: { library: { type: 'commonjs' } },
    plugins: [],
  });
  const runtimeChunk = webpackConfig.optimization?.runtimeChunk;
  const target = webpackConfig.target;
  webpackConfig.plugins.unshift(
    new NxAppWebpackPlugin({ ssr: true }),
    new NxReactWebpackPlugin(),
    {
      apply(compiler) {
        if (runtimeChunk !== undefined) {
          compiler.options.optimization.runtimeChunk = runtimeChunk;
        }
        compiler.options.target = target;
      },
    },
  );
  return webpackConfig;
};
