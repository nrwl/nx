{
  "$schema": "http://json-schema.org/schema",
  "$id": "NxOxlintLintProject",
  "title": "Add Oxlint to a project",
  "description": "Add Oxlint to an existing project.",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "description": "The name of the project.",
      "$default": {
        "$source": "projectName"
      },
      "x-prompt": "Which project should use Oxlint?"
    },
    "skipFormat": {
      "type": "boolean",
      "description": "Skip formatting files.",
      "default": false
    },
    "skipPackageJson": {
      "type": "boolean",
      "description": "Do not add dependencies to `package.json`.",
      "default": false
    },
    "keepExistingVersions": {
      "type": "boolean",
      "description": "Keep existing dependency versions when possible.",
      "default": false
    },
    "addPlugin": {
      "type": "boolean",
      "description": "Add the `@nx/oxlint/plugin` inference plugin to `nx.json`."
    },
    "addExplicitTargets": {
      "type": "boolean",
      "description": "Always add an explicit `@nx/oxlint:lint` target instead of relying on inferred tasks.",
      "default": false
    }
  },
  "required": ["project"],
  "additionalProperties": false
}
