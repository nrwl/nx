{
  "name": "conformance",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/conformance",
  "projectType": "library",
  "targets": {
    "build": {
      "command": "node ./scripts/copy-readme.js conformance packages/conformance/readme-template.md packages/conformance/README.md",
      "inputs": ["copyReadme"],
      "outputs": ["{projectRoot}/README.md"]
    },
    "test": {
      "inputs": [
        "...",
        "{workspaceRoot}/tools/vitest/**/*",
        "{workspaceRoot}/scripts/jest-mocks/clack-prompts.js"
      ]
    },
    "bench": {
      "command": "vitest bench --run",
      "options": {
        "cwd": "{projectRoot}"
      }
    }
  }
}
