{
  "name": "owners",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/owners",
  "projectType": "library",
  "targets": {
    "build": {
      "command": "node ./scripts/copy-readme.js owners packages/owners/readme-template.md packages/owners/README.md",
      "inputs": ["copyReadme"],
      "outputs": ["{projectRoot}/README.md"]
    },
    "test": {
      "inputs": [
        "...",
        "{workspaceRoot}/tools/vitest/**/*",
        "{workspaceRoot}/scripts/jest-mocks/clack-prompts.js"
      ]
    }
  }
}
