{
  "extends": "<%= offsetFromRoot %>tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/<%= e2eProjectName %>",
    "esModuleInterop": true,
    "noUnusedLocals": false,
    "noImplicitAny": false,
    "types": <%- testRunner === 'vitest' ? '["vitest/globals", "node"]' : '["jest", "node"]' %>
  },
  "include": [
    "<%= testRunner === 'vitest' ? 'vitest.config.mts' : 'jest.config.ts' %>",
    "src/**/*.ts"
  ],
  "references": []
}
