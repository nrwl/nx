{
  "name": "MsbuildAnalyzer",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:noop",
      "inputs": [
        "...",
        "{workspaceRoot}/Directory.Build.props",
        "{workspaceRoot}/.editorconfig"
      ],
      "dependsOn": ["build:dotnet"]
    },
    "run": {
      "executor": "nx:noop"
    },
    "publish": {
      "outputs": ["{projectRoot}/bin/Release/publish", "{projectRoot}/obj"]
    }
  }
}
