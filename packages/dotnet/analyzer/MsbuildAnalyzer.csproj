<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Allow running on newer .NET versions if net8.0 isn't available -->
    <RollForward>LatestMajor</RollForward>
    <RootNamespace>MsbuildAnalyzer</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!--
      Roslyn ships localized diagnostic resources in 13 satellite assemblies,
      ~6.5MB, which are shipped in the @nx/dotnet npm package. The analyzer only
      parses syntax and never reports a Roslyn diagnostic, so none of them are
      ever loaded.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Build packages provide ProjectGraph and evaluation APIs -->
    <!-- Using 17.* versions that support .NET Core/Standard -->
    <!-- ExcludeAssets="runtime" prevents copying MSBuild assemblies; MSBuildLocator will load them -->
    <PackageReference Include="Microsoft.Build" Version="17.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.8.1" />
    <!--
      Used to enumerate test classes and methods when a project opts into test
      splitting. Parsing only: no compilation and no semantic model.
      ExcludeAssets="runtime" for the same reason as the MSBuild packages above,
      with RoslynResolver loading the SDK's copy at startup.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project reach internal helpers without widening the
         analyzer's public surface. -->
    <InternalsVisibleTo Include="MsbuildAnalyzer.Tests" />
  </ItemGroup>

  <PropertyGroup>
    
  </PropertyGroup>

</Project>
