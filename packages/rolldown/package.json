{
  "name": "@nx/rolldown",
  "version": "0.0.1",
  "private": false,
  "type": "commonjs",
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "migrations.json",
    "generators.json"
  ],
  "description": "The Nx Plugin for Rolldown contains an inference plugin and generators for bundling projects with Rolldown.",
  "repository": {
    "type": "git",
    "url": "https://github.com/nrwl/nx.git",
    "directory": "packages/rolldown"
  },
  "keywords": [
    "Monorepo",
    "Rolldown",
    "Node",
    "CLI"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "plugin": [
        "dist/plugin.d.ts"
      ]
    }
  },
  "author": "Victor Savkin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nrwl/nx/issues"
  },
  "homepage": "https://nx.dev",
  "generators": "./generators.json",
  "nx-migrations": {
    "migrations": "./migrations.json",
    "supportsOptionalMigrations": true
  },
  "exports": {
    ".": {
      "@nx/nx-source": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./migrations.json": "./migrations.json",
    "./generators.json": "./generators.json",
    "./plugin": {
      "@nx/nx-source": "./plugin.ts",
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "dependencies": {
    "@nx/devkit": "workspace:*",
    "@nx/js": "workspace:*",
    "tslib": "catalog:typescript"
  },
  "peerDependencies": {
    "rolldown": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "rolldown": {
      "optional": true
    }
  },
  "devDependencies": {
    "nx": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
