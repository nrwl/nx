// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ci-workflow generator > connected to nxCloud > circleci pipeline > should match snapshot 1`] = `
"version: 2.1

orbs:
  nx: nrwl/nx@1.7.0

jobs:
  main:
    environment:
      # Configure the JVM to avoid OOM errors
      _JAVA_OPTIONS: '-Xmx3g'
      MAVEN_OPTS: '-Xmx3g'
    docker:
      - image: cimg/openjdk:21.0-node
    steps:
      - checkout

      # This enables task distribution via Nx Cloud
      # Run this command as early as possible, before dependencies are installed
      # Learn more at https://nx.dev/ci/reference/nx-cloud-cli#npx-nxcloud-startcirun
      # Uncomment this line to enable task distribution
      # - run: ./nx start-ci-run --distribute-on="3 linux-medium-jvm" --stop-agents-after="verify-ci"

      - nx/set-shas:
          main-branch-name: 'main'

      # # Nx Affected runs only tasks affected by the changes in this PR/commit. Learn more: https://nx.dev/ci/features/affected.
      - run:
          command: ./nx affected --base=$NX_BASE --head=$NX_HEAD -t verify-ci

workflows:
  version: 2

  ci:
    jobs:
      - main
"
`;

exports[`ci-workflow generator > connected to nxCloud > github pipeline > should match snapshot 1`] = `
"name: CI

on:
  push:
    branches:
      - main
  pull_request:

permissions:
  actions: read
  contents: read

jobs:
  main:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          filter: tree:0

      # This enables task distribution via Nx Cloud
      # Run this command as early as possible, before dependencies are installed
      # Learn more at https://nx.dev/ci/reference/nx-cloud-cli#npx-nxcloud-startcirun
      # Uncomment this line to enable task distribution
      # - run: ./nx start-ci-run --distribute-on="3 linux-medium-jvm" --stop-agents-after="verify-ci"

      - name: Set up JDK 21 for x64
        uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'
          architecture: x64

      - uses: nrwl/nx-set-shas@v5

      # Nx Affected runs only tasks affected by the changes in this PR/commit. Learn more: https://nx.dev/ci/features/affected.
      - run: ./nx affected -t verify-ci
"
`;

exports[`ci-workflow generator > connected to nxCloud > nx-cloud pipeline > should match snapshot 1`] = `
"# yaml-language-server: $schema=https://cloud.nx.app/nx-cloud/static/schemas/workflow.schema.json
# Nx Cloud CI runs this pipeline. It is in private beta, see https://nx.dev/docs/features/ci-features#run-ci-on-nx-cloud
# Learn how to configure this file at https://nx.dev/docs/reference/nx-cloud/ci-config
name: CI

on:
  pull-requests:
    event: PR
  main-pushes:
    event: PUSH
    branches: [main]

# The public JVM launch templates set up Gradle, so Maven workspaces get their own.
launch-templates:
  linux-medium-maven:
    resource-class: docker_linux_amd64/medium
    image: ubuntu22.04-node24.14-v1
    init-steps:
      - name: Checkout
        uses: nrwl/nx-cloud-workflows/v6/workflow-steps/checkout/main.yaml
      - name: Set up Nx
        script: ./nx --version

worker-templates:
  default:
    workers: 3 linux-medium-maven
    stop-after:
      - verify-ci

jobs:
  main:
    runs-on: linux-medium-maven
    workers: default
    steps:
      - run: ./nx affected -t verify-ci
"
`;

exports[`ci-workflow generator > not connected to nxCloud > circleci pipeline > should match snapshot 1`] = `
"version: 2.1

orbs:
  nx: nrwl/nx@1.7.0

jobs:
  main:
    environment:
      # Configure the JVM to avoid OOM errors
      _JAVA_OPTIONS: '-Xmx3g'
      MAVEN_OPTS: '-Xmx3g'
    docker:
      - image: cimg/openjdk:21.0-node
    steps:
      - checkout

      # This enables task distribution via Nx Cloud
      # Run this command as early as possible, before dependencies are installed
      # Learn more at https://nx.dev/ci/reference/nx-cloud-cli#npx-nxcloud-startcirun
      # Connect your workspace by running "nx connect" and uncomment this line to enable task distribution
      # - run: ./nx start-ci-run --distribute-on="3 linux-medium-jvm" --stop-agents-after="verify-ci"

      - nx/set-shas:
          main-branch-name: 'main'

      # # Nx Affected runs only tasks affected by the changes in this PR/commit. Learn more: https://nx.dev/ci/features/affected.
      - run:
          command: ./nx affected --base=$NX_BASE --head=$NX_HEAD -t verify-ci

workflows:
  version: 2

  ci:
    jobs:
      - main
"
`;

