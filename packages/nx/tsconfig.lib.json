{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "declarationDir": "dist",
    "declarationMap": false,
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "types": ["node"],
    "composite": true,
    "customConditions": ["@nx/nx-source"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "typescript/sync": [
        "../../node_modules/@typescript/native/dist/api/sync/api.d.ts"
      ],
      "typescript/fs": [
        "../../node_modules/@typescript/native/dist/api/fs.d.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*_spec.ts",
    "**/test-utils.ts",
    "jest.config.ts",
    "**/__fixtures__/**/*.*",
    "./src/internal-testing-utils/**/*.ts",
    ".eslintrc.json"
  ],
  "include": [
    "bin/**/*.ts",
    "nx-cloud-internals.ts",
    "plugins/**/*.ts",
    "release/**/*.ts",
    "src/**/*.ts",
    "src/**/*.json",
    "tasks-runners/**/*.ts"
  ]
}
