{
  "extends": "<%= baseTsConfigPath %>",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": false,
    "incremental": true,
    <% if(compiler === 'tsc') { %>
    "tsBuildInfoFile": "<%= offsetFromRoot %>tmp/buildcache/<%= projectRoot %>/server",
    <% } %>
    "types": [
      "node"
    ]
  },
  "include": [
    "server/**/*.ts"
  ]
}
