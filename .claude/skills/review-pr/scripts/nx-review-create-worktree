#!/usr/bin/env bash
set -euo pipefail

name="${1:?usage: nx-review-create-worktree NAME [head|base|prior]}"
case "$name" in
  ''|*[!a-z0-9-]*) echo "invalid worktree name: $name" >&2; exit 2 ;;
esac

case "${2:-head}" in
  head) ref=refs/review/head ;;
  base) ref=refs/review/base ;;
  prior) ref=refs/review/prior ;;
  *) echo "ref must be head, base, or prior" >&2; exit 2 ;;
esac

export PATH="/root/.local/bin:/root/.local/share/mise/shims:$PATH"
target="/work/mutations/$name"
test ! -e "$target" || { echo "$target already exists" >&2; exit 2; }
git -C /work/repo.git worktree add -q --detach "$target" "$ref"
cleanup() { git -C /work/repo.git worktree remove --force "$target" >/dev/null 2>&1 || true; }
trap cleanup ERR
cd "$target"
mise install
pnpm install --frozen-lockfile
trap - ERR
printf '%s\n' "$target"
